{
  "functions": {
    "api/og.js": {
      "includeFiles": "{og/fonts/**,node_modules/@resvg/resvg-wasm/index_bg.wasm}"
    },
    "api/block.js": {
      "includeFiles": "data/{schedules,enforcement,routes}.json"
    },
    "api/send-notifications.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "curb-nu.vercel.app"
        }
      ],
      "destination": "https://curb.guide/:path*",
      "statusCode": 308
    },
    {
      "source": "/n/presidio",
      "destination": "/n/",
      "statusCode": 301
    },
    {
      "source": "/n/golden-gate-park",
      "destination": "/n/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/config.js",
      "destination": "/api/config"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/tickets",
      "destination": "/tickets.html"
    },
    {
      "source": "/b/:cnn",
      "destination": "/api/block?cnn=:cnn"
    },
    {
      "source": "/n/:slug",
      "destination": "/n/:slug.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/press",
      "destination": "/press.html"
    },
    {
      "source": "/changelog",
      "destination": "/changelog.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    }
  ],
  "headers": [
    {
      "source": "/basemap/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), interest-cohort=()"
        }
      ]
    }
  ]
}
