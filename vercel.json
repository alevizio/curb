{
  "functions": {
    "api/og.js": {
      "includeFiles": "{og/fonts/**,node_modules/@resvg/resvg-wasm/index_bg.wasm,node_modules/harfbuzzjs/hb.wasm}"
    },
    "api/block.js": {
      "includeFiles": "data/{schedules,enforcement,routes}.json"
    },
    "api/send-notifications.js": {
      "maxDuration": 60,
      "includeFiles": "{data/schedules.json,data/*/winter.json}"
    }
  },
  "crons": [
    {
      "path": "/api/send-notifications",
      "schedule": "7,22,37,52 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "curb-nu.vercel.app"
        }
      ],
      "destination": "https://curb.guide/",
      "statusCode": 308
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "curb-nu.vercel.app"
        }
      ],
      "destination": "https://curb.guide/:path*",
      "statusCode": 308
    },
    {
      "source": "/n/presidio",
      "destination": "/n/",
      "statusCode": 301
    },
    {
      "source": "/n/golden-gate-park",
      "destination": "/n/",
      "statusCode": 301
    }
  ],
